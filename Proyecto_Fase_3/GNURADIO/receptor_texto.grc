- name: epy_pdu_a_texto
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nMuestra el texto recibido.\n - Entrada 'pdus'  : tramas con CRC correcto -> salida 'texto'\n - Entrada 'crudo' : todas las tramas detectadas (sin verificar CRC, se quitan\n                     los 4 bytes del CRC) -> salida 'texto_crudo'\nImprime en la consola cuantas tramas se detectaron y cuantas pasaron el CRC.\n\"\"\"\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    def __init__(self):\n        gr.basic_block.__init__(self, name='PDU a texto', in_sig=None, out_sig=None)\n        for p in ('pdus', 'crudo'):\n            self.message_port_register_in(pmt.intern(p))\n        self.message_port_register_out(pmt.intern('texto'))\n        self.message_port_register_out(pmt.intern('texto_crudo'))\n        self.set_msg_handler(pmt.intern('pdus'), self.handle_ok)\n        self.set_msg_handler(pmt.intern('crudo'), self.handle_raw)\n        self.n = 0\n        self.n_det = 0\n\n    @staticmethod\n    def _texto(msg, quitar=0):\n        datos = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        if quitar:\n            datos = datos[:-quitar]\n        return datos.decode('utf-8', errors='replace')\n\n    def handle_raw(self, msg):\n        self.n_det += 1\n        self.message_port_pub(pmt.intern('texto_crudo'), pmt.intern(self._texto(msg, 4)))\n        if self.n_det % 50 == 0:\n            print('[RX] tramas detectadas: %d | con CRC correcto: %d' % (self.n_det, self.n), flush=True)\n\n    def handle_ok(self, msg):\n        self.n += 1\n        texto = self._texto(msg)\n        print('[RX #%d] %s' % (self.n, texto), flush=True)\n        self.message_port_pub(pmt.intern('texto'), pmt.intern(texto))\n"
    comment: 'Imprime el texto en consola

      y lo envia a los cuadros QT'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2880
    - 800
    rotation: 0
    state: enabled
