- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Bloque_Estadistico',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32, np.float32, np.float32, np.float32, np.float32]\n\
      \        )\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        \n        out_media = output_items[0]\n        out_var   = output_items[1]\n\
      \        out_std   = output_items[2]\n        out_max   = output_items[3]\n\
      \        out_rms   = output_items[4]\n\n        N = len(x)\n        if N > 0:\n\
      \            media_val = np.mean(x)\n            var_val   = np.var(x)\n   \
      \         std_val   = np.std(x)\n            max_val   = np.max(x)\n       \
      \     rms_val   = np.sqrt(np.mean(x**2))\n\n            out_media[:] = media_val\n\
      \            out_var[:]   = var_val\n            out_std[:]   = std_val\n  \
      \          out_max[:]   = max_val\n            out_rms[:]   = rms_val\n\n  \
      \      return N"
    affinity: ''
    alias: Bloque estadistico
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Bloque_Estadistico', 'blk', [], [('0', 'float', 1)], [('0', 'float',
      1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1), ('4', 'float',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 416.0]
    rotation: 0
    state: enabled
